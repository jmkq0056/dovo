{
	"name": "maut-themes",
	"displayName": "Dovo Theme Studio",
	"description": "Visual theme + font customiser with live preview, presets, save/load. Includes a polished light mode.",
	"version": "1.3.3",
	"publisher": "maut",
	"license": "MIT",
	"engines": { "vscode": "^1.121.0" },
	"main": "./out/extension",
	"activationEvents": [
		"onStartupFinished",
		"onView:maut.themeStudio"
	],
	"capabilities": {
		"untrustedWorkspaces": { "supported": true },
		"virtualWorkspaces": true
	},
	"devDependencies": { "@types/node": "22.x" },
	"contributes": {
		"views": {
			"maut": [
				{
					"id": "maut.themeStudio",
					"name": "Theme Studio",
					"icon": "$(symbol-color)",
					"contextualTitle": "Dovo Theme Studio",
					"type": "webview"
				}
			]
		},
		"commands": [
			{ "command": "maut.theme.toggle", "title": "Toggle Dovo Light / Dark", "category": "Dovo", "icon": "$(color-mode)" },
			{ "command": "maut.theme.studio", "title": "Open Theme Studio", "category": "Dovo", "icon": "$(symbol-color)" }
		],
		"keybindings": [
			{ "command": "maut.theme.toggle", "key": "cmd+shift+l", "mac": "cmd+shift+l" },
			{ "command": "maut.theme.studio", "key": "cmd+shift+t", "mac": "cmd+shift+t" }
		],
		"menus": {
			"editor/title": [
				{ "command": "maut.theme.toggle", "group": "navigation@5" }
			]
		},
		"configuration": {
			"title": "Dovo",
			"properties": {
				"maut.workbenchFontFamily": {
					"type": "string",
					"default": "",
					"description": "Override the workbench UI font family (sidebar, tabs, menus, palette). Empty string = use VS Code default. Set by the Dovo Theme Studio when you pick a font."
				},
				"maut.workbenchFontSize": {
					"type": "number",
					"default": 0,
					"description": "Override the workbench UI font size in pixels. 0 = use VS Code default. Set by the Dovo Theme Studio when you pick a font size."
				}
			}
		}
	}
}
