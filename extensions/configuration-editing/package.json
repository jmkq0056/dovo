{
  "name": "configuration-editing",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "10.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.0.0"
  },
  "icon": "images/icon.png",
  "activationEvents": [
    "onProfile",
    "onProfile:github",
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "enabledApiProposals": [
    "profileContentHandlers"
  ],
  "main": "./out/configurationEditingMain",
  "browser": "./dist/browser/configurationEditingMain",
  "scripts": {
    "compile": "gulp compile-extension:configuration-editing",
    "watch": "gulp watch-extension:configuration-editing",
    "compile-web": "npm-run-all2 -lp bundle-web typecheck-web",
    "bundle-web": "node ./esbuild.browser.mts",
    "typecheck-web": "tsgo --project ./tsconfig.browser.json --noEmit",
    "watch-web": "npm-run-all2 -lp watch-bundle-web watch-typecheck-web",
    "watch-bundle-web": "node ./esbuild.browser.mts --watch",
    "watch-typecheck-web": "tsgo --project ./tsconfig.browser.json --noEmit --watch"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "jsonc-parser": "^3.2.0",
    "tunnel": "^0.0.6"
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configurationDefaults": {
      "chat.commandCenter.enabled": false,
      "chat.experimental.offerSetup": false,
      "chat.setupFromDialog": false,
      "editor.inlineSuggest.enabled": false,
      "editor.inlineSuggest.suppressSuggestions": true,
      "editor.suggest.preview": false,
      "github.copilot.enable": {
        "*": false
      },
      "github.copilot.editor.enableAutoCompletions": false,
      "github.copilot.nextEditSuggestions.enabled": false,
      "workbench.commandPalette.experimental.suggestCommands": false,
      "workbench.startupEditor": "none",
      "workbench.colorTheme": "Default Dark Modern",
      "workbench.iconTheme": "vscode-icons-mac",
      "zenMode.centerLayout": false,
      "zenMode.hideTabs": false,
      "zenMode.fullScreen": false,
      "zenMode.hideActivityBar": true,
      "zenMode.hideStatusBar": true,
      "zenMode.silentNotifications": false,
      "zenMode.restore": false,
      "terminal.integrated.enableImages": true,
      "terminal.integrated.gpuAcceleration": "on",
      "editor.fontFamily": "'JetBrains Mono', 'JetBrainsMono Nerd Font', 'Fira Code', 'SF Mono', Menlo, Monaco, 'Courier New', monospace",
      "editor.fontLigatures": true,
      "editor.fontWeight": "400",
      "editor.fontSize": 13,
      "editor.lineHeight": 1.5,
      "terminal.integrated.fontFamily": "'JetBrains Mono', 'JetBrainsMono Nerd Font', 'Fira Code', 'SF Mono', Menlo, Monaco, 'Courier New', monospace",
      "terminal.integrated.fontSize": 13,
      "terminal.integrated.lineHeight": 1.1,
      "terminal.integrated.fontWeight": "400",
      "terminal.integrated.tabs.title": "${sequence}${separator}${process}",
      "terminal.integrated.tabs.description": "${task}${separator}${local}${separator}${cwdFolder}",
      "workbench.hover.delay": 80,
      "editor.hover.delay": 80,
      "editor.hover.sticky": true,
      "workbench.colorCustomizations": {
        "[Dark Modern]": {
          "focusBorder": "#f59e0b",
          "foreground": "#f0f0f8",
          "descriptionForeground": "#b3a89b",
          "errorForeground": "#e8465f",
          "selection.background": "#f59e0b55",
          "editor.background": "#1f1a1d",
          "editor.foreground": "#f0f0f8",
          "editor.selectionBackground": "#f59e0b44",
          "editor.lineHighlightBackground": "#2e2629",
          "editorCursor.foreground": "#f59e0b",
          "editorWhitespace.foreground": "#4a403a",
          "editorIndentGuide.background1": "#2e2629",
          "editorIndentGuide.activeBackground1": "#f59e0b66",
          "editorLineNumber.foreground": "#4a403a",
          "editorLineNumber.activeForeground": "#fbbf24",
          "editorBracketMatch.background": "#f59e0b33",
          "editorBracketMatch.border": "#f59e0b",
          "editorGroupHeader.tabsBackground": "#1f1a1d",
          "editorGroup.border": "#2e2629",
          "tab.activeBackground": "#2e2629",
          "tab.inactiveBackground": "#1f1a1d",
          "tab.activeForeground": "#f0f0f8",
          "tab.inactiveForeground": "#7d7268",
          "tab.activeBorderTop": "#f59e0b",
          "tab.border": "#1f1a1d",
          "tab.hoverBackground": "#181416",
          "titleBar.activeBackground": "#1f1a1d",
          "titleBar.activeForeground": "#f0f0f8",
          "titleBar.inactiveBackground": "#1f1a1d",
          "titleBar.inactiveForeground": "#7d7268",
          "titleBar.border": "#2e2629",
          "activityBar.background": "#1f1a1d",
          "activityBar.foreground": "#f0f0f8",
          "activityBar.inactiveForeground": "#7d7268",
          "activityBar.activeBorder": "#f59e0b",
          "activityBar.activeBackground": "#2e2629",
          "activityBar.border": "#1f1a1d",
          "activityBarBadge.background": "#f59e0b",
          "activityBarBadge.foreground": "#f0f0f8",
          "sideBar.background": "#1f1a1d",
          "sideBar.foreground": "#b3a89b",
          "sideBar.border": "#1f1a1d",
          "sideBarSectionHeader.background": "#1f1a1d",
          "sideBarSectionHeader.foreground": "#7d7268",
          "sideBarTitle.foreground": "#f0f0f8",
          "panel.background": "#1f1a1d",
          "panel.border": "#2e2629",
          "panelTitle.activeForeground": "#f0f0f8",
          "panelTitle.inactiveForeground": "#7d7268",
          "panelTitle.activeBorder": "#f59e0b",
          "statusBar.background": "#1f1a1d",
          "statusBar.foreground": "#b3a89b",
          "statusBar.border": "#2e2629",
          "statusBar.noFolderBackground": "#1f1a1d",
          "statusBar.debuggingBackground": "#f59e0b",
          "statusBarItem.remoteBackground": "#f59e0b",
          "statusBarItem.remoteForeground": "#f0f0f8",
          "statusBarItem.hoverBackground": "#2e2629",
          "statusBarItem.prominentBackground": "#f59e0b",
          "terminal.background": "#1f1a1d",
          "terminal.foreground": "#f0f0f8",
          "terminalCursor.background": "#1f1a1d",
          "terminalCursor.foreground": "#f59e0b",
          "terminal.ansiRed": "#f59e0b",
          "terminal.ansiBrightRed": "#fbbf24",
          "terminal.ansiBlue": "#7d7268",
          "terminal.ansiBrightBlue": "#b3a89b",
          "terminal.ansiBlack": "#1f1a1d",
          "terminal.ansiBrightBlack": "#2e2629",
          "terminal.ansiWhite": "#b3a89b",
          "terminal.ansiBrightWhite": "#f0f0f8",
          "button.background": "#f59e0b",
          "button.foreground": "#f0f0f8",
          "button.hoverBackground": "#fbbf24",
          "button.secondaryBackground": "#2e2629",
          "button.secondaryForeground": "#b3a89b",
          "button.secondaryHoverBackground": "#181416",
          "input.background": "#181416",
          "input.foreground": "#f0f0f8",
          "input.border": "#2e2629",
          "input.placeholderForeground": "#4a403a",
          "inputOption.activeBorder": "#f59e0b",
          "inputOption.activeBackground": "#f59e0b33",
          "dropdown.background": "#181416",
          "dropdown.foreground": "#f0f0f8",
          "dropdown.border": "#2e2629",
          "list.activeSelectionBackground": "#2e2629",
          "list.activeSelectionForeground": "#fbbf24",
          "list.inactiveSelectionBackground": "#181416",
          "list.inactiveSelectionForeground": "#f0f0f8",
          "list.hoverBackground": "#181416",
          "list.hoverForeground": "#f0f0f8",
          "list.focusBackground": "#2e2629",
          "list.focusForeground": "#f0f0f8",
          "list.highlightForeground": "#fbbf24",
          "scrollbarSlider.background": "#2e262988",
          "scrollbarSlider.hoverBackground": "#f59e0b44",
          "scrollbarSlider.activeBackground": "#f59e0b66",
          "badge.background": "#f59e0b",
          "badge.foreground": "#f0f0f8",
          "progressBar.background": "#f59e0b",
          "menu.background": "#181416",
          "menu.foreground": "#f0f0f8",
          "menu.border": "#2e2629",
          "menu.selectionBackground": "#f59e0b",
          "menu.selectionForeground": "#ffffff",
          "menu.selectionBorder": "#fbbf24",
          "menu.separatorBackground": "#2e2629",
          "menubar.selectionBackground": "#f59e0b",
          "menubar.selectionForeground": "#ffffff",
          "menubar.selectionBorder": "#fbbf24",
          "quickInputList.focusBackground": "#f59e0b",
          "quickInputList.focusForeground": "#ffffff",
          "notifications.background": "#181416",
          "notifications.foreground": "#f0f0f8",
          "notifications.border": "#2e2629",
          "notificationLink.foreground": "#fbbf24",
          "notificationCenterHeader.background": "#1f1a1d",
          "notificationCenterHeader.foreground": "#f0f0f8",
          "quickInput.background": "#181416",
          "quickInput.foreground": "#f0f0f8",
          "quickInputTitle.background": "#1f1a1d",
          "pickerGroup.foreground": "#f59e0b",
          "pickerGroup.border": "#2e2629",
          "editorWidget.background": "#181416",
          "editorWidget.border": "#2e2629",
          "editorSuggestWidget.background": "#181416",
          "editorSuggestWidget.border": "#2e2629",
          "editorSuggestWidget.foreground": "#f0f0f8",
          "editorSuggestWidget.highlightForeground": "#fbbf24",
          "editorSuggestWidget.selectedBackground": "#2e2629",
          "editorHoverWidget.background": "#181416",
          "editorHoverWidget.border": "#2e2629",
          "editorGutter.background": "#1f1a1d",
          "editorGutter.modifiedBackground": "#f59e0b",
          "editorGutter.addedBackground": "#7d7268",
          "editorGutter.deletedBackground": "#e8465f",
          "diffEditor.insertedTextBackground": "#7d726822",
          "diffEditor.removedTextBackground": "#f59e0b22",
          "textLink.foreground": "#fbbf24",
          "textLink.activeForeground": "#f59e0b",
          "breadcrumb.background": "#1f1a1d",
          "breadcrumb.foreground": "#7d7268",
          "breadcrumb.focusForeground": "#f0f0f8",
          "breadcrumb.activeSelectionForeground": "#fbbf24",
          "minimap.background": "#1f1a1d",
          "minimap.selectionHighlight": "#f59e0b44",
          "minimapSlider.background": "#2e262988",
          "minimapSlider.hoverBackground": "#f59e0b44"
        }
      }
    },
    "languages": [
      {
        "id": "jsonc",
        "extensions": [
          ".code-workspace",
          "language-configuration.json",
          "icon-theme.json",
          "color-theme.json"
        ],
        "filenames": [
          "settings.json",
          "launch.json",
          "tasks.json",
          "mcp.json",
          "keybindings.json",
          "extensions.json",
          "argv.json",
          "profiles.json",
          "devcontainer.json",
          ".devcontainer.json"
        ]
      },
      {
        "id": "json",
        "extensions": [
          ".code-profile"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "vscode://defaultsettings/keybindings.json",
        "url": "vscode://schemas/keybindings"
      },
      {
        "fileMatch": "%APP_SETTINGS_HOME%/keybindings.json",
        "url": "vscode://schemas/keybindings"
      },
      {
        "fileMatch": "%APP_SETTINGS_HOME%/profiles/*/keybindings.json",
        "url": "vscode://schemas/keybindings"
      },
      {
        "fileMatch": "vscode://defaultsettings/*.json",
        "url": "vscode://schemas/settings/default"
      },
      {
        "fileMatch": "%APP_SETTINGS_HOME%/settings.json",
        "url": "vscode://schemas/settings/user"
      },
      {
        "fileMatch": "%APP_SETTINGS_HOME%/profiles/*/settings.json",
        "url": "vscode://schemas/settings/profile"
      },
      {
        "fileMatch": "%MACHINE_SETTINGS_HOME%/settings.json",
        "url": "vscode://schemas/settings/machine"
      },
      {
        "fileMatch": "%APP_WORKSPACES_HOME%/*/workspace.json",
        "url": "vscode://schemas/workspaceConfig"
      },
      {
        "fileMatch": "**/*.code-workspace",
        "url": "vscode://schemas/workspaceConfig"
      },
      {
        "fileMatch": "**/argv.json",
        "url": "vscode://schemas/argv"
      },
      {
        "fileMatch": "/.vscode/settings.json",
        "url": "vscode://schemas/settings/folder"
      },
      {
        "fileMatch": "/.vscode/launch.json",
        "url": "vscode://schemas/launch"
      },
      {
        "fileMatch": "/.vscode/tasks.json",
        "url": "vscode://schemas/tasks"
      },
      {
        "fileMatch": "/.vscode/mcp.json",
        "url": "vscode://schemas/mcp"
      },
      {
        "fileMatch": "%APP_SETTINGS_HOME%/tasks.json",
        "url": "vscode://schemas/tasks"
      },
      {
        "fileMatch": "%APP_SETTINGS_HOME%/snippets/*.json",
        "url": "vscode://schemas/snippets"
      },
      {
        "fileMatch": "%APP_SETTINGS_HOME%/prompts/*.toolsets.jsonc",
        "url": "vscode://schemas/toolsets"
      },
      {
        "fileMatch": "%APP_SETTINGS_HOME%/profiles/*/snippets/.json",
        "url": "vscode://schemas/snippets"
      },
      {
        "fileMatch": "%APP_SETTINGS_HOME%/sync/snippets/preview/*.json",
        "url": "vscode://schemas/snippets"
      },
      {
        "fileMatch": "**/*.code-snippets",
        "url": "vscode://schemas/global-snippets"
      },
      {
        "fileMatch": "/.vscode/extensions.json",
        "url": "vscode://schemas/extensions"
      },
      {
        "fileMatch": "devcontainer.json",
        "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json"
      },
      {
        "fileMatch": ".devcontainer.json",
        "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json"
      },
      {
        "fileMatch": "%APP_SETTINGS_HOME%/globalStorage/ms-vscode-remote.remote-containers/nameConfigs/*.json",
        "url": "./schemas/attachContainer.schema.json"
      },
      {
        "fileMatch": "%APP_SETTINGS_HOME%/globalStorage/ms-vscode-remote.remote-containers/imageConfigs/*.json",
        "url": "./schemas/attachContainer.schema.json"
      },
      {
        "fileMatch": "**/quality/*/product.json",
        "url": "vscode://schemas/vscode-product"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
